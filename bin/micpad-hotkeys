#!/usr/bin/env python3
"""Add optional shortcuts only after checking the running compositor."""
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

BEGIN = '-- BEGIN MICPAD SHORTCUTS'
END = '-- END MICPAD SHORTCUTS'


def render():
    lines = [BEGIN]
    for i in range(1, 10):
        lines.append(f'o.bind("CTRL + ALT + {i}", "Micpad sound {i}", "micpad play {i}")')
    lines.append('o.bind("CTRL + ALT + 0", "Micpad stop", "micpad stop")')
    return '\n'.join(lines + [END]) + '\n'


def call(*args):
    result = subprocess.run(['hyprctl', *args], capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or 'Hyprland unavailable')
    return result.stdout.strip()


def atomic_write(path, content, mode):
    fd, name = tempfile.mkstemp(prefix='.micpad-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(name, mode)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def main():
    if sys.argv[1:] == ['--render']:
        print(render(), end='')
        return
    path = Path.home() / '.config/hypr/bindings.lua'
    if not path.is_file() or path.is_symlink():
        raise RuntimeError('Expected a regular ~/.config/hypr/bindings.lua file')
    original = path.read_text()
    if BEGIN in original:
        print('Micpad shortcuts are already configured.')
        return
    errors = call('configerrors')
    if errors and errors != 'ok':
        raise RuntimeError('Resolve existing Hyprland config errors before enabling shortcuts: ' + errors)
    binds = json.loads(call('-j', 'binds'))
    for bind in binds:
        # XKB Control=4, Mod1/Alt=8. Never replace an existing binding.
        key = str(bind.get('key', ''))
        code = int(bind.get('keycode', 0))
        if int(bind.get('modmask', 0)) == 12 and ((len(key) == 1 and key in '0123456789') or 10 <= code <= 19):
            raise RuntimeError('Shortcut conflict: Ctrl+Alt+' + (key or ('keycode ' + str(code))))
    mode = path.stat().st_mode & 0o777
    backup = path.with_name('bindings.lua.bak.micpad-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
    shutil.copy2(path, backup)
    updated = original.rstrip() + '\n\n' + render()
    # Abort instead of overwriting an edit made while diagnostics were running.
    if path.read_text() != original:
        raise RuntimeError('Keybindings changed during the check; please try again.')
    atomic_write(path, updated, mode)
    try:
        call('reload')
        errors = call('configerrors')
        if errors and errors != 'ok':
            raise RuntimeError(errors)
    except Exception:
        if path.read_text() == updated:
            atomic_write(path, original, mode)
            call('reload')
        raise
    print('Global shortcuts enabled. Backup: ' + str(backup))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
